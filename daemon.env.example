# Use a unique VM_NAME for every daemon EC2 and an AWS region code (for example ap-south-2).
VM_NAME=REPLACE_WITH_UNIQUE_NODE_NAME
VM_REGION=ap-south-2
# Required for automatic EC2 stop/start; find this in the EC2 console.
VM_INSTANCE_ID=
CONTROL_PLANE_URL=https://your-control-panel-domain.example
DAEMON_SECRET=CHANGE_ME_MATCH_CONTROL_PLANE

# Optional; automatic public IP discovery is used when this is empty.
VM_PUBLIC_IP=
MAX_SERVER_SLOTS=5
MINECRAFT_BIND_IP=0.0.0.0
DAEMON_DATA_PATH=/opt/crafthost-data
