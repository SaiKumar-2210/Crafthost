# Copy to .env and replace CHANGE_ME values with long random secrets.
# MongoDB Atlas connection string (or your local MongoDB URI).
# URL-encode special characters in the database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crafthost?retryWrites=true&w=majority

# Only used by the bundled local MongoDB service; not needed for Atlas.
MONGO_ROOT_USERNAME=crafthost
MONGO_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
DAEMON_SECRET=CHANGE_ME

# Optional public hostnames used for player connection addresses.
HOSTNAME_INDIA=
HOSTNAME_KOREA=

# Optional AWS auto provisioning credentials; blank means manually managed daemons.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_KEY_PAIR_NAME=

# Enable AWS API access through an IAM role attached to the control-plane EC2.
# The role needs DescribeInstances, StartInstances, and StopInstances permissions.
AWS_INSTANCE_PROFILE_ENABLED=false

# Stop empty Minecraft servers after 10 minutes; EC2 auto-stop is opt-in.
AUTO_STOP_IDLE_SERVERS=true
AUTO_STOP_IDLE_EC2=false

CONTROL_PORT=3000
