# Copy to .env and replace CHANGE_ME values with long random secrets.
MONGO_ROOT_USERNAME=crafthost
MONGO_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
DAEMON_SECRET=CHANGE_ME

# Optional public hostnames used for player connection addresses.
HOSTNAME_INDIA=
HOSTNAME_KOREA=

# Optional AWS auto provisioning credentials; blank means manually managed daemons.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_KEY_PAIR_NAME=

CONTROL_PORT=3000
